# 奏疏：为本项目创建独立 conda 环境

## 第一步：创建环境（用 mamba 更快，miniforge3 自带）

mamba create -n pyfin python=3.12 -y

# 如果 mamba 报错找不到，改用 conda（会慢一些）：
# conda create -n pyfin python=3.12 -y

## 第二步：激活新环境

conda activate pyfin

## 第三步：安装项目依赖

pip install flask flask-cors akshare pandas numpy

## 第四步：验证安装

python -c "import flask; import akshare; import pandas; import numpy; print('环境就绪')"

## 第五步：运行项目

cd /home/zewang/projects/PythonFinance
python stock_server.py

# 浏览器打开 http://localhost:5000
